# =============================================================================
# EC2 / Docker production — not for local laptops (see docs/ENVIRONMENT.md).
# =============================================================================
# Single .env for api + web containers. Django calls FastAPI internally:
#   RYUNOVA_API_BASE=http://api:8010/api/v1

# --- FastAPI (public URLs in JSON) ------------------------------------------
# Reference (Latrobe): SITE_DOMAIN=ryunova.latrobecomputing.co.in → API_PUBLIC_URL=https://ryunova-api.latrobecomputing.co.in
# (deploy script default). ACM *.latrobecomputing.co.in covers that API host; Route 53 A alias → same ALB as the app.
API_PUBLIC_URL=https://ryunova-api.latrobecomputing.co.in
# Same path the api container mounts from ./data/uploads (see docker-compose.app-only.yml).
UPLOAD_DIR=/app/uploads
SITE_URL=https://ryunova.latrobecomputing.co.in
SITE_DOMAIN=ryunova.latrobecomputing.co.in
DATABASE_URL=postgresql+psycopg://USER:PASS@host.docker.internal:5432/latrobe_apps_db
SECRET_KEY=long-random-string
CORS_ORIGINS=https://ryunova.latrobecomputing.co.in,http://127.0.0.1:8011

# --- Django -----------------------------------------------------------------
DJANGO_SECRET_KEY=long-random-string
DEBUG=false
USE_WHITENOISE=true
USE_TLS_BEHIND_PROXY=true
RYUNOVA_API_BASE=http://api:8010/api/v1
RYUNOVA_API_PUBLIC=https://ryunova-api.latrobecomputing.co.in
RYUNOVA_API_PUBLIC_PORT=443
RYUNOVA_REWRITE_API_PUBLIC_IN_RESPONSES=false
ALLOWED_HOSTS=ryunova.latrobecomputing.co.in,ryunova-api.latrobecomputing.co.in,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://ryunova.latrobecomputing.co.in,https://ryunova-api.latrobecomputing.co.in

# S3 (optional; set USE_S3_MEDIA=true + instance IAM for PutObject/DeleteObject/GetObject)
AWS_S3_MEDIA_BUCKET=ryunova-channels-organisations-media
AWS_S3_REGION=ap-southeast-2
USE_S3_MEDIA=false
# Optional; not used for browser img URLs (those go via API_PUBLIC_URL + /api/v1/media). CloudFront note only.
MEDIA_PUBLIC_BASE_URL=

# --- SMTP (optional) --------------------------------------------------------
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
EMAIL_HOST_USER_NAME=RyuNova Platform
